<Window x:Class="MeshChat.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MeshChat.Converters"
        xmlns:models="clr-namespace:MeshChat.Models"
        Title="{Binding TitleWithUnread}"
        Height="720" Width="1150"
        MinHeight="600" MinWidth="900"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        FontFamily="{DynamicResource AppFontFamily}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/MainWindowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:PeerStatusColorConverter x:Key="PeerStatusColor"/>
            <conv:FileSizeConverter x:Key="FileSize"/>
            <conv:UnreadVisibilityConverter x:Key="UnreadVis"/>
            <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
            <conv:MessageStatusConverter x:Key="MsgStatus"/>
            <conv:StatusColorConverter x:Key="StatusColor"/>
            <conv:TransportColorConverter x:Key="TransportColor"/>
            <conv:NotSystemVisibilityConverter x:Key="NotSystemVis"/>
            <conv:IsSystemVisibilityConverter x:Key="IsSystemVis"/>
            <conv:IsDateSeparatorVisibilityConverter x:Key="IsDateSepVis"/>
            <conv:NullToBoolConverter x:Key="NullToBool"/>
            <conv:DoubleToVisibilityConverter x:Key="DoubleVis"/>
            <conv:MessageAlignmentConverter x:Key="MsgAlign"/>
            <conv:BubbleColorConverter x:Key="BubbleColor"/>
            <conv:BubbleTextColorConverter x:Key="BubbleTextColor"/>
            <conv:AvatarGradientConverter x:Key="AvatarGradient"/>
            <conv:TypingVisibilityConverter x:Key="TypingVis"/>
            <conv:LogEntryToInlinesConverter x:Key="LogInlines"/>
            <conv:StringToVisibilityConverter x:Key="StringToVisConverter"/>
            <conv:SignalBarColorConverter x:Key="BarColor"/>
            <conv:LastSeenTextConverter x:Key="LastSeenText"/>
            <conv:LastSeenVisibilityConverter x:Key="LastSeenVis"/>
            <conv:PeerStatusTextConverter x:Key="PeerStatusText"/>
            <conv:PeerStatusTextColorConverter x:Key="PeerStatusTextColor"/>
            <conv:ErrorToastColorConverter x:Key="ErrorToastColor"/>
            <conv:ReactionsVisibilityConverter x:Key="ReactionsVis"/>
            <conv:ReactionsToCollectionConverter x:Key="ReactionsToCollection"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource AppBackgroundBrush}" CornerRadius="14" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.45" Color="{StaticResource WindowShadowColor}"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,14,0,0"
                    Panel.ZIndex="20"
                    Visibility="{Binding ToastVisible, Converter={StaticResource BoolVis}}">
                <Border.Background>
                    <SolidColorBrush Color="{Binding ToastIsError, Converter={StaticResource ErrorToastColor}}"/>
                </Border.Background>
                <Border CornerRadius="12" Padding="16,10">
                    <TextBlock Text="{Binding ToastMessage}"
                               Foreground="White"
                               FontSize="13"
                               TextWrapping="Wrap"
                               MaxWidth="380"/>
                </Border>
            </Border>

            <!-- Custom title bar keeps app identity and window commands available without the native chrome. -->
            <Border x:Name="HeaderBorder"
                    Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0"
                    Padding="18,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource SentGradientBrush}" Margin="0,0,10,0">
                            <TextBlock Text="M"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MeshChat" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding LocalId, StringFormat='ID {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="10,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0"/>
                                <TextBlock Text="WiFi" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="10,6" Visibility="{Binding IsBluetoothAvailable, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource BluetoothBrush}" Margin="0,0,7,0"/>
                                <TextBlock Text="Bluetooth" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="SearchTextBox"
                                 Width="150"
                                 Margin="0,0,8,0"
                                 Style="{StaticResource HeaderTextBox}"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search messages"
                                 ToolTip="Search messages"/>
                        <Button Content="Clear"
                                Margin="0,0,8,0"
                                Click="ClearSearch_Click"
                                Style="{StaticResource IconButton}"
                                ToolTip="Clear search"/>
                        <Button Content="Encrypt"
                                Margin="0,0,8,0"
                                Click="EncryptionToggle_Click"
                                Style="{StaticResource IconButton}"
                                ToolTip="Toggle encryption">
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="Loaded"/>
                            </Button.Triggers>
                        </Button>
                        <Button Content="Log"
                                Margin="0,0,8,0"
                                Click="LogToggleButton_Click"
                                Style="{StaticResource LogToggleButton}"
                                ToolTip="Toggle network log"/>
                        <Button Content="_"
                                Width="36"
                                Margin="0,0,6,0"
                                Click="MinimizeButton_Click"
                                Style="{StaticResource IconButton}"
                                ToolTip="Minimize"/>
                        <Button Content="X"
                                Width="36"
                                Click="CloseButton_Click"
                                Style="{StaticResource IconButton}"
                                ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280" x:Name="NetworkLogColumn"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar spacing is intentionally fixed so peer rows do not shift as badges appear. -->
                <Border x:Name="SidebarBorder"
                        Grid.Column="0"
                        Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="16"
                        Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Peers" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Peers.Count, StringFormat='{}{0} peer(s) on network'}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Width="38"
                                    Height="38"
                                    Click="AddDeviceButton_Click"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Add peer manually">
                                <Border x:Name="PlusButtonBorder"
                                        Width="20"
                                        Height="20"
                                        CornerRadius="10"
                                        Background="{StaticResource AccentBrush}"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform/>
                                    </Border.RenderTransform>
                                    <TextBlock Text="+"
                                               Foreground="{StaticResource DarkButtonTextBrush}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Button>
                        </Grid>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Peers}"
                                 SelectedItem="{Binding SelectedPeer}"
                                 AutomationProperties.Name="Network peers"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Peer}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar gradients are converter-picked from the peer ID for stable user colors. -->
                                        <Border Grid.Column="0"
                                                Width="38"
                                                Height="38"
                                                CornerRadius="14"
                                                Background="{Binding Id, Converter={StaticResource AvatarGradient}}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding InitialLetter}"
                                                       Foreground="White"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Ellipse Width="7" Height="7" Fill="{Binding Status, Converter={StaticResource PeerStatusColor}}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Status, Converter={StaticResource PeerStatusText}}"
                                                           Foreground="{Binding Status, Converter={StaticResource PeerStatusTextColor}}"
                                                           FontSize="11"/>
                                                <TextBlock Text=" - " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding HopDescription}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LastSeen, Converter={StaticResource LastSeenText}}"
                                                       Visibility="{Binding Status, Converter={StaticResource LastSeenVis}}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding SecurityStatus}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Border Background="{StaticResource FileCardBrush}"
                                                    CornerRadius="10"
                                                    Padding="8,4"
                                                    Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Transport}"
                                                           Foreground="{Binding Transport, Converter={StaticResource TransportColor}}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="{StaticResource AccentBrush}"
                                                    CornerRadius="9"
                                                    Padding="6,2"
                                                    Visibility="{Binding UnreadCount, Converter={StaticResource UnreadVis}}">
                                                <TextBlock Text="{Binding UnreadCount}"
                                                           Foreground="{StaticResource DarkButtonTextBrush}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border x:Name="ManualConnectPanel"
                                Grid.Row="2"
                                Visibility="Collapsed"
                                Opacity="0"
                                IsHitTestVisible="False"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="14"
                                Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Manual connect"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>
                                <TextBox Text="{Binding ConnectIp, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxChrome}"
                                         Margin="0,0,0,8"
                                         AutomationProperties.Name="Peer IP address"
                                         ToolTip="Peer IP address"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding ConnectPort, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextBoxChrome}"
                                             Margin="0,0,8,0"
                                             AutomationProperties.Name="Port"
                                             ToolTip="Port"/>
                                    <Button Grid.Column="1"
                                            Content="Connect"
                                            Click="ConnectButton_Click"
                                            Style="{StaticResource AccentButton}"
                                            AutomationProperties.Name="Connect to device"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- The splitter gives the peer pane a native WPF collapse/resize affordance without view-model state. -->
                <GridSplitter Grid.Column="1"
                              Width="4"
                              HorizontalAlignment="Stretch"
                              Background="{StaticResource PanelBrush}"
                              ShowsPreview="True"
                              ResizeBehavior="PreviousAndNext"/>

                <Grid x:Name="MainContentGrid" Grid.Column="2" Background="{StaticResource AppBackgroundBrush}" Opacity="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="88"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource AppBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="22,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedPeer.DisplayName, TargetNullValue=Broadcast, FallbackValue=Broadcast}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedPeerSecurityStatus, TargetNullValue='Messages sent here are broadcast to the mesh', FallbackValue='Messages sent here are broadcast to the mesh'}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedPeer.HopDescription}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <Button Content="Attach"
                                        Click="SendFileButton_Click"
                                        Style="{StaticResource ChromeButton}"
                                        IsEnabled="{Binding SelectedPeer, Converter={StaticResource NullToBool}}"
                                        ToolTip="Attach a file"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Message virtualization requires the ListBox to own scrolling; wrapping it in a ScrollViewer would materialize every chat card. -->
                    <ListBox x:Name="MessagesList"
                             Grid.Row="1"
                             Background="{StaticResource AppBackgroundBrush}"
                             Padding="{StaticResource MessageListPadding}"
                             ItemsSource="{Binding FilteredMessages}"
                             ItemContainerStyle="{StaticResource MessageListItemStyle}"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ChatMessage}">
                                    <Grid Margin="0,0,0,12">
                                        <Border Visibility="{Binding Type, Converter={StaticResource IsDateSepVis}}"
                                                HorizontalAlignment="Center"
                                                Background="{StaticResource ReactionCardBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12,5"
                                                Margin="0,2,0,10">
                                            <TextBlock Text="{Binding DateSeparatorText}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"/>
                                        </Border>

                                        <Border Visibility="{Binding Type, Converter={StaticResource IsSystemVis}}"
                                                HorizontalAlignment="Center"
                                                Background="{StaticResource ReactionCardBrush}"
                                                CornerRadius="12"
                                                Padding="12,7"
                                                Margin="0,2,0,10">
                                            <TextBlock Text="{Binding Content}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                        </Border>

                                        <StackPanel Visibility="{Binding Type, Converter={StaticResource NotSystemVis}}">
                                            <StackPanel.HorizontalAlignment>
                                                <MultiBinding Converter="{StaticResource MsgAlign}">
                                                    <Binding Path="SenderId"/>
                                                    <Binding Path="DataContext.LocalId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </StackPanel.HorizontalAlignment>

                                            <Border x:Name="MessageCard"
                                                    MaxWidth="520"
                                                    CornerRadius="{StaticResource MessageCardRadius}"
                                                    Padding="{StaticResource MessageCardPadding}"
                                                    BorderThickness="1"
                                                    BorderBrush="{StaticResource BorderBrush}">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource BubbleColor}">
                                                        <Binding Path="SenderId"/>
                                                        <Binding Path="DataContext.LocalId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="Type"/>
                                                    </MultiBinding>
                                                </Border.Background>
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Copy Message" Click="CopyMessage_Click"/>
                                                        <MenuItem Header="Copy Sender" Click="CopySender_Click"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>

                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding SenderName}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Foreground>
                                                                <MultiBinding Converter="{StaticResource BubbleTextColor}">
                                                                    <Binding Path="SenderId"/>
                                                                    <Binding Path="DataContext.LocalId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                </MultiBinding>
                                                            </TextBlock.Foreground>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Margin="12,1,0,0"/>
                                                    </Grid>

                                                    <TextBlock Text="{Binding Content}"
                                                               FontSize="14"
                                                               FontWeight="Normal"
                                                               LineHeight="20"
                                                               TextWrapping="Wrap">
                                                        <TextBlock.Foreground>
                                                            <MultiBinding Converter="{StaticResource BubbleTextColor}">
                                                                <Binding Path="SenderId"/>
                                                                <Binding Path="DataContext.LocalId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </TextBlock.Foreground>
                                                    </TextBlock>

                                                    <Border Background="{StaticResource FileCardBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="10"
                                                            Margin="0,10,0,0"
                                                            Visibility="{Binding FileName, Converter={StaticResource StringToVisConverter}}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding FileName}"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSize}}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11"
                                                                       Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding FilePath}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,4,0,0"
                                                                       Visibility="{Binding FilePath, Converter={StaticResource StringToVisConverter}}"/>
                                                            <ProgressBar Value="{Binding FileProgress}"
                                                                         Maximum="1"
                                                                         Height="5"
                                                                         Margin="0,8,0,0"
                                                                         Visibility="{Binding FileProgress, Converter={StaticResource DoubleVis}}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <ItemsControl ItemsSource="{Binding Reactions, Converter={StaticResource ReactionsToCollection}}"
                                                                  Visibility="{Binding Reactions, Converter={StaticResource ReactionsVis}}"
                                                                  Margin="0,10,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{StaticResource ReactionCardBrush}"
                                                                        BorderBrush="{StaticResource BorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="10"
                                                                        Padding="7,3"
                                                                        Margin="0,0,6,4">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Emoji}" FontSize="12" Margin="0,0,4,0"/>
                                                                        <TextBlock Text="{Binding Count}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Orientation="Horizontal"
                                                        Margin="6,5,6,0"
                                                        HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}, Path=HorizontalAlignment}">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource MsgStatus}}"
                                                           FontSize="11"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusColor}}"/>
                                                <TextBlock Text="{Binding Transport, StringFormat=' via {0}'}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12,8"
                            Margin="22,0,22,10"
                            Visibility="{Binding IsPeerTyping, Converter={StaticResource TypingVis}}">
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                            <Run Text="{Binding TypingPeerName}"/>
                            <Run Text=" is typing..."/>
                        </TextBlock>
                    </Border>

                    <!-- Input spacing leaves a clear target for keyboard focus and touch without crowding the message list. -->
                    <Border Grid.Row="3"
                            Background="{StaticResource InputBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,1,0,0"
                            Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MessageTextBox"
                                     Grid.Column="0"
                                     Text="{Binding MessageInput, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxChrome}"
                                     AcceptsReturn="False"
                                     KeyDown="MessageInput_KeyDown"
                                     AutomationProperties.Name="Message"
                                     ToolTip="Message"/>
                            <Button Grid.Column="2"
                                    Click="SendButton_Click"
                                    Style="{StaticResource SendButton}"
                                    AutomationProperties.Name="Send message"
                                    ToolTip="Send message"/>
                        </Grid>
                    </Border>
                </Grid>

                <Border x:Name="NetworkLogPanel"
                        Grid.Column="3"
                        Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1,0,0,0"
                        Width="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource HeaderBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="14">
                            <Grid>
                                <TextBlock Text="Network log"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding LogFilterOptions}"
                                          SelectedItem="{Binding LogFilter}"
                                          Width="104"
                                          HorizontalAlignment="Right"
                                          AutomationProperties.Name="Activity log filter"
                                          ToolTip="Activity log filter"/>
                            </Grid>
                        </Border>

                        <!-- Log virtualization mirrors messages: recycled containers keep the live activity feed light. -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding FilteredLogs}"
                                 ItemContainerStyle="{StaticResource LogListItemStyle}"
                                 Padding="12"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="11"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding TagColor}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Tag}" Foreground="{Binding TagColor}" FontSize="11" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Timestamp, StringFormat='  {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Message}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           LineHeight="18"
                                                           Margin="0,6,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Status bar uses two explicit lines so transport and mesh routing remain readable at small widths. -->
            <Border Grid.Row="2"
                    Background="{StaticResource StatusBarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14"
                    Padding="18,7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding StatusText}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="11"
                               Opacity="0.86"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center">
                        <Run Text="Transport: WiFi"/>
                        <Run Text=" + Bluetooth when available"/>
                        <Run Text=" | Mesh routing enabled"/>
                        <Run Text=" | Port "/>
                        <Run Text="{Binding ConnectPort}"/>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
