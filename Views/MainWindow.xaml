<Window x:Class="MeshChat.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MeshChat.ViewModels"
        xmlns:conv="clr-namespace:MeshChat.Converters"
        xmlns:models="clr-namespace:MeshChat.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="{Binding TitleWithUnread}"
        Height="720" Width="1150"
        MinHeight="600" MinWidth="900"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        FontFamily="-apple-system, BlinkMacSystemFont, SF Pro Display, SF Pro Text, Segoe UI Variable, system-ui, sans-serif"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <conv:PeerStatusColorConverter x:Key="PeerStatusColor"/>
        <conv:FileSizeConverter x:Key="FileSize"/>
        <conv:UnreadVisibilityConverter x:Key="UnreadVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:MessageStatusConverter x:Key="MsgStatus"/>
        <conv:StatusColorConverter x:Key="StatusColor"/>
        <conv:TransportColorConverter x:Key="TransportColor"/>
        <conv:NotSystemVisibilityConverter x:Key="NotSystemVis"/>
        <conv:IsSystemVisibilityConverter x:Key="IsSystemVis"/>
        <conv:IsDateSeparatorVisibilityConverter x:Key="IsDateSepVis"/>
        <conv:NullToBoolConverter x:Key="NullToBool"/>
        <conv:DoubleToVisibilityConverter x:Key="DoubleVis"/>
        <conv:MessageAlignmentConverter x:Key="MsgAlign"/>
        <conv:BubbleColorConverter x:Key="BubbleColor"/>
        <conv:BubbleTextColorConverter x:Key="BubbleTextColor"/>
        <conv:DateSeparatorConverter x:Key="DateSep"/>
        <conv:AvatarGradientConverter x:Key="AvatarGradient"/>
        <conv:TypingVisibilityConverter x:Key="TypingVis"/>
        <conv:UnreadTitleConverter x:Key="UnreadTitle"/>
        <conv:BoolToFontWeightConverter x:Key="BoolToFontWeight"/>
        <conv:LogEntryToInlinesConverter x:Key="LogInlines"/>
        <conv:StringToVisibilityConverter x:Key="StringToVisConverter"/>
        <conv:SignalStrengthConverter x:Key="SignalStrength"/>
        <conv:QualityColorConverter x:Key="QualityColor"/>
        <conv:SignalBarsConverter x:Key="SignalBars"/>
        <conv:SignalBarColorConverter x:Key="BarColor"/>
        <conv:LastSeenTextConverter x:Key="LastSeenText"/>
        <conv:LastSeenVisibilityConverter x:Key="LastSeenVis"/>
        <conv:PeerStatusTextConverter x:Key="PeerStatusText"/>
        <conv:PeerStatusTextColorConverter x:Key="PeerStatusTextColor"/>
        <conv:ErrorToastColorConverter x:Key="ErrorToastColor"/>

        <!-- Clean design tokens from TypeUI clean skill -->
        <SolidColorBrush x:Key="CleanPrimaryBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="CleanSecondaryBrush" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="CleanSuccessBrush" Color="#16A34A"/>
        <SolidColorBrush x:Key="CleanWarningBrush" Color="#D97706"/>
        <SolidColorBrush x:Key="CleanDangerBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="CleanSurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CleanTextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="CleanMutedTextBrush" Color="#99111827"/>
        <SolidColorBrush x:Key="CleanSubtleBrush" Color="#0D111827"/>
        <SolidColorBrush x:Key="CleanBorderBrush" Color="#1A111827"/>

        <!-- Smooth message animation style -->
        <Style x:Key="AnimatedMessageStyle" TargetType="ContentPresenter">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="10"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="15" To="0" Duration="0:0:0.3">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- MODERN ANIMATIONS                                                     -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->

        <!-- Window Fade In Animation -->
        <Storyboard x:Key="WindowFadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Header Slide Down Animation -->
        <Storyboard x:Key="HeaderSlideIn">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="-20" To="0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Sidebar Slide In Animation -->
        <Storyboard x:Key="SidebarSlideIn">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="-30" To="0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Chat Area Fade In Animation -->
        <Storyboard x:Key="ChatAreaFadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Button Press Animation (scale down) -->
        <Storyboard x:Key="ButtonPressAnim">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             To="0.92" Duration="0:0:0.08"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             To="0.92" Duration="0:0:0.08"/>
        </Storyboard>

        <!-- Button Release Animation (scale back) -->
        <Storyboard x:Key="ButtonReleaseAnim">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             To="1" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             To="1" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Log Toggle Button Hover Effect -->
        <Style x:Key="LogToggleButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent"
                                CornerRadius="8" Padding="12,6"
                                BorderBrush="#1FFFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A0A84FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#330A84FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#330A84FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toast Notification Overlay -->
        <Border Grid.Row="0" HorizontalAlignment="Center" Margin="0,16,0,0"
                VerticalAlignment="Top" Panel.ZIndex="1000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="{Binding ToastVisible, Converter={StaticResource BoolVis}}"/>
                </Style>
            </Border.Style>
            <Border.Background>
                <SolidColorBrush Color="{Binding ToastIsError, Converter={StaticResource ErrorToastColor}}"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="Black"/>
            </Border.Effect>
            <Border CornerRadius="12" Padding="16,12">
                <TextBlock Text="{Binding ToastMessage}" FontSize="13" Foreground="White"
                           TextWrapping="Wrap" MaxWidth="350"/>
            </Border>
        </Border>

        <!-- Modern Gradient Background -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="{StaticResource ModernBackgroundGradient}" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
            </Border.Effect>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- GLASSMORPHISM 2.0 HEADER                                             -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->

        <Border Grid.Row="0" Padding="20,16"
                Background="#D91C1C1E"
                BorderBrush="#1AFFFFFF"
                BorderThickness="0,0,0,1"
                CornerRadius="12,12,0,0"
                MouseLeftButtonDown="Header_MouseLeftButtonDown"
                x:Name="HeaderBorder"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.3" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Logo & Identity -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0A84FF" Offset="0"/>
                                <GradientStop Color="#007AFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="⬡" FontSize="16" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="MeshChat" FontSize="15" FontWeight="Medium" Foreground="#FFFFFF"/>
                        <TextBlock Text="Offline P2P" FontSize="11" Foreground="#8E8E93" Margin="0,-1,0,0"/>
                    </StackPanel>

                    <!-- User Identity -->
                    <Border Background="#14FFFFFF" CornerRadius="8" Padding="10,6"
                            BorderBrush="#1FFFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="11" Margin="0,0,6,0" Foreground="#8E8E93"/>
                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#FFFFFF" FontSize="12" Width="90"
                                     CaretBrush="#0A84FF"
                                     AutomationProperties.Name="Display name"
                                     ToolTip="Display name"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center: Status Indicators -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- WiFi Status -->
                    <Border Background="#260A84FF" CornerRadius="8" Padding="10,6" Margin="0,0,8,0"
                            BorderBrush="#4D0A84FF" BorderThickness="1"
                            Visibility="{Binding IsWifiConnected, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#30D158" Margin="0,0,6,0"/>
                            <TextBlock Text="WiFi" FontSize="11" Foreground="#64D2FF" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>

                    <!-- Bluetooth Status -->
                    <Border Background="#268E8E93" CornerRadius="8" Padding="10,6"
                            BorderBrush="#4D8E8E93" BorderThickness="1"
                            Visibility="{Binding IsBluetoothAvailable, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#BF5AF2" Margin="0,0,6,0"/>
                            <TextBlock Text="BT" FontSize="11" Foreground="#BF5AF2" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Search + Network Log Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Box -->
                    <Border Background="#1C1C1E" CornerRadius="6" Padding="6,3"
                            BorderBrush="#3A3A3C" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#x1F50D;" FontSize="10"
                                       Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#FFFFFF" FontSize="11" Width="100"
                                     CaretBrush="#0A84FF" x:Name="SearchTextBox"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="Search messages"
                                     ToolTip="Search messages (Ctrl+F)"/>
                            <Button Grid.Column="2" Click="ClearSearch_Click"
                                    Style="{StaticResource IconButton}"
                                    Width="28" Height="28" Padding="2" Margin="2,0,0,0"
                                    AutomationProperties.Name="Clear search"
                                    ToolTip="Clear search"
                                    Visibility="{Binding SearchQuery, Converter={StaticResource StringToVisConverter}}">
                                <TextBlock Text="&#x2715;" FontSize="8" Foreground="#6B7280"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Encryption Toggle -->
                    <Button Click="EncryptionToggle_Click"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="Toggle Encryption"
                            AutomationProperties.Name="Toggle encryption"
                            Style="{StaticResource IconButton}" Margin="4,0,0,0">
                        <Border Background="#14FFFFFF" CornerRadius="8"
                                Padding="10,6" BorderBrush="#1FFFFFFF" BorderThickness="1">
                            <TextBlock FontSize="12" Foreground="#8E8E93">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="🔓"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EncryptionEnabled}" Value="True">
                                                <Setter Property="Text" Value="🔒"/>
                                                <Setter Property="Foreground" Value="#30D158"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Button>

                    <Button Click="LogToggleButton_Click"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="Toggle Network Log"
                            AutomationProperties.Name="Toggle network log"
                            Style="{StaticResource IconButton}" Margin="4,0,0,0">
                        <Border Background="#14FFFFFF" CornerRadius="8"
                                Padding="12,6" BorderBrush="#1FFFFFFF" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4C4;" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Log" FontSize="11" Foreground="#8E8E93"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- Window Controls -->
                    <Button Click="MinimizeButton_Click" Style="{StaticResource IconButton}"
                            Padding="12,4" Margin="8,0,0,0"
                            AutomationProperties.Name="Minimize window"
                            ToolTip="Minimize">
                        <TextBlock Text="&#x2212;" FontSize="14" Foreground="#8E8E93"/>
                    </Button>
                    <Button Click="CloseButton_Click" Style="{StaticResource IconButton}"
                            Padding="12,4"
                            AutomationProperties.Name="Close window"
                            ToolTip="Close">
                        <TextBlock Text="&#x2715;" FontSize="12" Foreground="#8E8E93"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT                                                           -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->

        <Grid Grid.Row="1" x:Name="MainContentGrid" Opacity="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280" x:Name="NetworkLogColumn"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════════════════════════════════ -->
            <!-- SIDEBAR - Device List - Glassmorphism 2.0                              -->
            <!-- ═══════════════════════════════════════════════════════════════════════ -->

            <Border Grid.Column="0" Background="#08000000"
                    BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0"
                    x:Name="SidebarBorder"
                    Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header - Liquid Glass -->
                    <Border Grid.Row="0" Padding="16,14" BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="DEVICES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <Border Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="6,2" Margin="8,0,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.3" Color="#38BDF8"/>
                                        </Border.Effect>
                                        <TextBlock Text="{Binding Peers.Count}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Peers.Count, StringFormat='{}{0} peer(s) on network'}"
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <!-- Add Device Button -->
                            <Button Grid.Column="1" Click="AddDeviceButton_Click"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" ToolTip="Add device manually"
                                    AutomationProperties.Name="Add device manually"
                                    VerticalAlignment="Center" Style="{StaticResource IconButton}">
                                <Border x:Name="PlusButtonBorder" Background="#14FFFFFF" CornerRadius="6"
                                        Padding="8,4" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <TextBlock Text="+" FontSize="16" FontWeight="Light"
                                               Foreground="#8E8E93"/>
                                </Border>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Peer List -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Peers}"
                             SelectedItem="{Binding SelectedPeer}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ModernListBoxItem}"/>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Squircle Avatar with Mesh Gradient -->
                                    <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0">
                                        <Border CornerRadius="12">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#38BDF8"/>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding InitialLetter}"
                                                       FontSize="17" FontWeight="SemiBold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Ellipse Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                 Stroke="#0F172A" StrokeThickness="2" Fill="#22C55E"/>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <!-- Online status dot with status text -->
                                            <Ellipse Width="6" Height="6" Margin="0,0,5,0"
                                                     Fill="{Binding Status, Converter={StaticResource PeerStatusColor}}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Status, Converter={StaticResource PeerStatusText}}"
                                                       FontSize="11"
                                                       Foreground="{Binding Status, Converter={StaticResource PeerStatusTextColor}}"
                                                       VerticalAlignment="Center"/>
                                            <!-- Last seen for offline/away -->
                                            <TextBlock Text="{Binding LastSeen, Converter={StaticResource LastSeenText}}"
                                                       FontSize="11" Margin="6,0,0,0"
                                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                                       Visibility="{Binding Status, Converter={StaticResource LastSeenVis}}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Signal Strength + Unread Badge -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Visual Signal Bars -->
                                        <Grid Width="28" Height="14" Margin="0,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="2"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="2"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="2"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Bar 1 (shortest) -->
                                            <Border Grid.Column="0" CornerRadius="1" VerticalAlignment="Bottom" Height="4"
                                                    Background="{Binding SignalStrength, Converter={StaticResource BarColor}, ConverterParameter=1}"/>
                                            <!-- Bar 2 -->
                                            <Border Grid.Column="2" CornerRadius="1" VerticalAlignment="Bottom" Height="7"
                                                    Background="{Binding SignalStrength, Converter={StaticResource BarColor}, ConverterParameter=2}"/>
                                            <!-- Bar 3 -->
                                            <Border Grid.Column="4" CornerRadius="1" VerticalAlignment="Bottom" Height="10"
                                                    Background="{Binding SignalStrength, Converter={StaticResource BarColor}, ConverterParameter=3}"/>
                                            <!-- Bar 4 (tallest) -->
                                            <Border Grid.Column="6" CornerRadius="1" VerticalAlignment="Bottom" Height="14"
                                                    Background="{Binding SignalStrength, Converter={StaticResource BarColor}, ConverterParameter=4}"/>
                                        </Grid>
                                        <!-- Unread Badge -->
                                        <Border Background="{StaticResource AccentBrush}" CornerRadius="12"
                                                Padding="8,3"
                                                Visibility="{Binding UnreadCount, Converter={StaticResource UnreadVis}}">
                                            <TextBlock Text="{Binding UnreadCount}" FontSize="11"
                                                       Foreground="White" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Peers.Count}" Value="0">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate>
                                                    <StackPanel VerticalAlignment="Center" Margin="20">
                                                        <Border Width="60" Height="60" CornerRadius="30" HorizontalAlignment="Center" Margin="0,0,0,16">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#27272A" Offset="0"/>
                                                                    <GradientStop Color="#18181D" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <TextBlock Text="⬡" FontSize="28" HorizontalAlignment="Center"
                                                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="No devices found" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                        <TextBlock Text="Searching the network..." FontSize="12"
                                                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                    </ListBox>

                    <!-- Manual Connect (Hidden - shown in popup) -->
                    <Border Grid.Row="2" Padding="14" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0" x:Name="ManualConnectPanel"
                            Visibility="Collapsed" Opacity="1">
                        <StackPanel>
                            <TextBlock Text="MANUAL CONNECT" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding ConnectIp, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     Background="{StaticResource SurfaceElevatedBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     FontSize="12" Padding="10,8" Tag="IP Address" Margin="0,0,0,8"
                                     AutomationProperties.Name="IP address"
                                     ToolTip="IP address">
                                <TextBox.Resources>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
                                </TextBox.Resources>
                            </TextBox>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ConnectPort}"
                                          Background="{StaticResource SurfaceElevatedBrush}"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          BorderBrush="{StaticResource BorderBrush}"
                                          BorderThickness="1" Padding="10,8" FontSize="12" Margin="0,0,8,0"
                                          CaretBrush="{StaticResource TextPrimaryBrush}"
                                          Style="{StaticResource ModernTextBox}"
                                          AutomationProperties.Name="Port"
                                          ToolTip="Port"/>
                                <Button Grid.Column="1" Content="Connect"
                                        Style="{StaticResource PrimaryButton}"
                                        FontSize="12" Padding="10,8"
                                        AutomationProperties.Name="Connect to device"
                                        Click="ConnectButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════════════ -->
            <!-- CHAT AREA                                                             -->
            <!-- ═══════════════════════════════════════════════════════════════════════ -->

            <Grid Grid.Column="1" Background="#FAFFFFFF"
                  TextElement.FontFamily="Roboto, Segoe UI Variable, Segoe UI, system-ui, sans-serif">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Broadcast Header Card -->
                <Border Grid.Row="0" Background="{StaticResource CleanSurfaceBrush}"
                        BorderBrush="{StaticResource CleanBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="20,16" Margin="24,20,24,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.08" Color="#111827"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="BROADCAST CHANNEL"
                                       FontFamily="Inconsolata, Consolas, monospace"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource CleanMutedTextBrush}"
                                       Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Poppins, Segoe UI Variable, Segoe UI, sans-serif"
                                           FontSize="24" FontWeight="SemiBold"
                                           Foreground="{StaticResource CleanTextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Broadcast"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPeer}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="Broadcast"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Background="#1A3B82F6" CornerRadius="8" Padding="8,4"
                                        Margin="12,2,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="all peers" FontSize="12" FontWeight="Medium"
                                               Foreground="{StaticResource CleanPrimaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedPeer.HopDescription}" FontSize="12"
                                       Foreground="{StaticResource CleanMutedTextBrush}" Margin="0,6,0,0"/>
                        </StackPanel>

                        <Button HorizontalAlignment="Right" Content="📎 Send File"
                                Grid.Column="1"
                                Style="{StaticResource PrimaryButton}"
                                Background="{StaticResource CleanPrimaryBrush}"
                                FontSize="12" Padding="16,10"
                                Click="SendFileButton_Click"
                                AutomationProperties.Name="Send file"
                                IsEnabled="{Binding SelectedPeer, Converter={StaticResource NullToBool}}"/>
                    </Grid>
                </Border>

                <!-- Messages Card -->
                <ScrollViewer Grid.Row="1" x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto"
                              Background="Transparent" Padding="24,0,24,12">
                    <Border Background="{StaticResource CleanSurfaceBrush}"
                            BorderBrush="{StaticResource CleanBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.06" Color="#111827"/>
                        </Border.Effect>
                        <ItemsControl ItemsSource="{Binding FilteredMessages}" x:Name="MessagesList"
                                  ItemContainerStyle="{StaticResource AnimatedMessageStyle}"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.CacheLength="5,5"
                                  VirtualizingStackPanel.CacheLengthUnit="Page"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <!-- Date Separator -->
                                    <Border Visibility="{Binding Type, Converter={StaticResource IsDateSepVis}}"
                                            HorizontalAlignment="Center" Margin="0,16,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{StaticResource CleanSubtleBrush}"
                                                    CornerRadius="8" Padding="12,4">
                                                <TextBlock Text="{Binding DateSeparatorText}" FontSize="11"
                                                           Foreground="{StaticResource CleanMutedTextBrush}"
                                                           FontWeight="Medium"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- System Message -->
                                    <TextBlock Text="{Binding Content}" FontSize="12" Foreground="{StaticResource CleanMutedTextBrush}"
                                               HorizontalAlignment="Center" Margin="0,12"
                                               Visibility="{Binding Type, Converter={StaticResource IsSystemVis}}"/>

                                    <!-- Modern clean chat cards -->
                                    <StackPanel Visibility="{Binding Type, Converter={StaticResource NotSystemVis}}">
                                        <!-- Message Bubble -->
                                        <Border x:Name="bubble" MaxWidth="420" CornerRadius="8" Padding="16,12"
                                                Margin="0,4,64,2" BorderBrush="{StaticResource CleanBorderBrush}"
                                                BorderThickness="1">
                                            <Border.ContextMenu>
                                                <ContextMenu Background="{StaticResource CleanSurfaceBrush}" BorderBrush="{StaticResource CleanBorderBrush}">
                                                    <MenuItem Header="Copy Message" Click="CopyMessage_Click"
                                                              Foreground="{StaticResource CleanTextBrush}" Background="Transparent"/>
                                                    <MenuItem Header="Copy Sender" Click="CopySender_Click"
                                                              Foreground="{StaticResource CleanTextBrush}" Background="Transparent"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Border.HorizontalAlignment>
                                                <MultiBinding Converter="{StaticResource MsgAlign}">
                                                    <Binding Path="SenderId"/>
                                                    <Binding Path="DataContext.LocalId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </Border.HorizontalAlignment>
                                            <!-- Dynamic background based on sent/received -->
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource BubbleColor}">
                                                    <Binding Path="SenderId"/>
                                                    <Binding Path="DataContext.LocalId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    <Binding Path="Type"/>
                                                </MultiBinding>
                                            </Border.Background>
                                            <StackPanel>
                                                <!-- Sender Name (only show for received messages) -->
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#3B82F6"/>
                                                            <Setter Property="Text" Value="{Binding SenderName}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SenderId, Converter={StaticResource NullToBool}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Message Content -->
                                                <TextBlock Text="{Binding Content}" FontSize="14" TextWrapping="Wrap"
                                                           LineHeight="20">
                                                    <TextBlock.Foreground>
                                                        <MultiBinding Converter="{StaticResource BubbleTextColor}">
                                                            <Binding Path="SenderId"/>
                                                            <Binding Path="DataContext.LocalId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        </MultiBinding>
                                                    </TextBlock.Foreground>
                                                </TextBlock>

                                                <!-- File Attachment -->
                                                <Border Background="#143B82F6" CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:MessageType.File}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📄" FontSize="14" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Medium">
                                                                <TextBlock.Foreground>
                                                                    <MultiBinding Converter="{StaticResource BubbleTextColor}">
                                                                        <Binding Path="SenderId"/>
                                                                        <Binding Path="DataContext.LocalId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Foreground>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSize}}"
                                                                   FontSize="11" Opacity="0.7" Margin="0,2,0,0">
                                                            <TextBlock.Foreground>
                                                                <MultiBinding Converter="{StaticResource BubbleTextColor}">
                                                                    <Binding Path="SenderId"/>
                                                                    <Binding Path="DataContext.LocalId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                </MultiBinding>
                                                            </TextBlock.Foreground>
                                                        </TextBlock>
                                                        <ProgressBar Value="{Binding FileProgress}" Maximum="1" Height="4" Margin="0,6,0,0"
                                                                     Background="#1A111827" Foreground="{StaticResource CleanPrimaryBrush}"
                                                                     Visibility="{Binding FileProgress, Converter={StaticResource DoubleVis}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Metadata: Timestamp + Status UNDER the bubble (iMessage-style) -->
                                        <Grid Margin="4,2,68,6">
                                            <Grid.HorizontalAlignment>
                                                <MultiBinding Converter="{StaticResource MsgAlign}">
                                                    <Binding Path="SenderId"/>
                                                    <Binding Path="DataContext.LocalId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </Grid.HorizontalAlignment>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm}" FontSize="11" Foreground="{StaticResource CleanMutedTextBrush}"/>
                                                <TextBlock Text="{Binding Status, Converter={StaticResource MsgStatus}}"
                                                           FontSize="12" Foreground="{Binding Status, Converter={StaticResource StatusColor}}" Margin="6,0,0,0"/>
                                                <TextBlock Text="{Binding Transport}" FontSize="11" Foreground="{StaticResource CleanMutedTextBrush}" Margin="6,0,0,0" Opacity="0.8"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </ScrollViewer>

                <!-- Typing Indicator (simplified for performance) -->
                <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                        Margin="44,0,0,28" Padding="14,10"
                        Background="{StaticResource CleanSurfaceBrush}"
                        BorderBrush="{StaticResource CleanBorderBrush}" BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding IsPeerTyping, Converter={StaticResource TypingVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TypingPeerName}" FontSize="12" Foreground="{StaticResource CleanPrimaryBrush}" FontWeight="Medium"/>
                        <TextBlock Text=" is typing..." FontSize="12" Foreground="{StaticResource CleanMutedTextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Message Input Card -->
                <Border Grid.Row="2" Background="Transparent" Padding="24,0,24,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource CleanSurfaceBrush}" CornerRadius="8"
                                Padding="8" BorderBrush="{StaticResource CleanBorderBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.08" Color="#111827"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Text="{Binding MessageInput, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource CleanTextBrush}" FontSize="15" Padding="16,12"
                                         AcceptsReturn="False" KeyDown="MessageInput_KeyDown"
                                         CaretBrush="#3B82F6" x:Name="MessageTextBox"
                                         AutomationProperties.Name="Message"
                                         ToolTip="Message"
                                         Style="{StaticResource ChatInputStyle}"/>

                                <!-- Modern Send Button with Glow -->
                                <Button Grid.Column="2" Click="SendButton_Click"
                                        Style="{StaticResource SendButton}"
                                        AutomationProperties.Name="Send message"
                                        ToolTip="Send message">
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════════════ -->
            <!-- NETWORK LOG PANEL - Modern Terminal                                   -->
            <!-- ═══════════════════════════════════════════════════════════════════════ -->

            <Border x:Name="NetworkLogPanel" Grid.Column="2" Background="#0D0D0F"
                    BorderBrush="#1FFFFFFF" BorderThickness="1,0,0,0"
                    Width="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header - Clean Minimal -->
                    <Border Grid.Row="0" Background="#18181A" Padding="12,8"
                            BorderBrush="#2A2A2E" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Activity" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#FFFFFF" VerticalAlignment="Center"
                                           FontFamily="Segoe UI"/>
                                <!-- Filter Dropdown -->
                                <ComboBox ItemsSource="{Binding LogFilterOptions}"
                                          SelectedItem="{Binding LogFilter}"
                                          Background="#1C1C1E" Foreground="#FFFFFF"
                                          BorderBrush="#3A3A3C" BorderThickness="1"
                                          Margin="12,0,0,0"
                                          Padding="8,4" FontSize="10"
                                          Width="75" VerticalAlignment="Center"
                                          AutomationProperties.Name="Activity log filter"
                                          ToolTip="Activity log filter">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ComboBox">
                                                        <Border x:Name="ComboFocusBorder"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="1"
                                                                CornerRadius="4">
                                                        <Grid>
                                                            <ToggleButton x:Name="ToggleButton"
                                                                          Focusable="False"
                                                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                          ClickMode="Press">
                                                                <ToggleButton.Template>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border x:Name="Border" Background="#1C1C1E"
                                                                                BorderBrush="#3A3A3C" BorderThickness="1"
                                                                                CornerRadius="4">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="20"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <ContentPresenter Grid.Column="0"/>
                                                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0"
                                                                                      Fill="#8E8E93" HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                            </Grid>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </ToggleButton.Template>
                                                            </ToggleButton>
                                                            <ContentPresenter x:Name="ContentSite"
                                                                              IsHitTestVisible="False"
                                                                              Content="{TemplateBinding SelectionBoxItem}"
                                                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                              Margin="8,4,24,4"
                                                                              VerticalAlignment="Center"
                                                                              HorizontalAlignment="Left"/>
                                                            <Popup x:Name="Popup" Placement="Bottom"
                                                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                                                   AllowsTransparency="True" Focusable="False"
                                                                   PopupAnimation="Slide">
                                                                <Grid x:Name="DropDown" SnapsToDevicePixels="True"
                                                                      MinWidth="{TemplateBinding ActualWidth}"
                                                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                                    <Border x:Name="DropDownBorder" Background="#1C1C1E"
                                                                            BorderBrush="#3A3A3C" BorderThickness="1"
                                                                            CornerRadius="4" Margin="0,2,0,0"/>
                                                                    <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                                    </ScrollViewer>
                                                                </Grid>
                                                            </Popup>
                                                        </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                <Setter TargetName="ComboFocusBorder" Property="BorderBrush" Value="#60A5FA"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.55"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ComboBox.Style>
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ComboBoxItem">
                                                        <Border x:Name="Border" Background="Transparent"
                                                                BorderBrush="Transparent" BorderThickness="1"
                                                                Padding="{TemplateBinding Padding}" CornerRadius="3">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter TargetName="Border" Property="Background" Value="#2C2C2E"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Border" Property="Background" Value="#0A84FF"/>
                                                            </Trigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="Border" Property="BorderBrush" Value="#60A5FA"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </StackPanel>
                            <!-- Compact live indicator -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#30D158">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.8" Color="#30D158"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Log Content - Clean Card Style -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="#0D0D0F"
                                  Padding="8,6">
                        <ItemsControl ItemsSource="{Binding FilteredLogs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="LogEntryBorder" Margin="0,3" CornerRadius="8" Padding="12,10"
                                            Background="#18181A" Opacity="0">
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Top Row: Tag badge with colored indicator -->
                                            <Grid Grid.Row="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- Colored dot indicator -->
                                                    <Ellipse Width="8" Height="8" Fill="{Binding TagColor}"
                                                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <!-- Tag -->
                                                    <Border Background="{Binding TagColor}"
                                                            CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Tag}"
                                                                   FontSize="9" FontWeight="Bold"
                                                                   Foreground="White"
                                                                   FontFamily="Segoe UI"/>
                                                    </Border>
                                                    <!-- Timestamp -->
                                                    <TextBlock Text="{Binding Timestamp}"
                                                               FontSize="10" Foreground="#5A5A5E"
                                                               FontFamily="Consolas, monospace"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Message -->
                                            <TextBlock Grid.Row="1" Text="{Binding Message}"
                                                       FontSize="11.5" Foreground="#E0E0E5"
                                                       TextWrapping="Wrap"
                                                       FontFamily="Segoe UI"
                                                       Margin="0,6,0,0"
                                                       LineHeight="17"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- STATUS BAR                                                              -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center">
                    <Run Text="Min 2 devices ·"/>
                    <Run Text="Mesh routing enabled"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
