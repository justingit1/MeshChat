<Application x:Class="MeshChat.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- FRESH MODERN 2026 - Midnight Slate & Sky Blue Palette              -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->

            <!-- Apple Accent Blue -->
            <Color x:Key="AccentColor">#0A84FF</Color>
            <Color x:Key="AccentDarkColor">#0066CC</Color>
            <Color x:Key="AccentLightColor">#64D2FF</Color>

            <!-- Apple Dark Mode Palette -->
            <Color x:Key="BackgroundColor">#1C1C1E</Color>
            <Color x:Key="SurfaceColor">#2C2C2E</Color>
            <Color x:Key="SurfaceElevatedColor">#3A3A3C</Color>
            <Color x:Key="SidebarColor">#1C1C1E</Color>
            <Color x:Key="SidebarHoverColor">#2C2C2E</Color>
            <Color x:Key="SidebarActiveColor">#3A3A3C</Color>

            <!-- Text Colors - Apple Dark Mode -->
            <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
            <Color x:Key="TextSecondaryColor">#EBEBF5</Color>
            <Color x:Key="TextMutedColor">#8E8E93</Color>

            <!-- Message Bubbles - Apple Style -->
            <Color x:Key="BubbleSentColor">#0A84FF</Color>
            <Color x:Key="BubbleSentDarkColor">#0066CC</Color>
            <Color x:Key="BubbleReceivedColor">#3A3A3C</Color>
            <Color x:Key="BubbleReceivedHoverColor">#48484A</Color>

            <!-- Status Colors -->
            <Color x:Key="OnlineColor">#22C55E</Color>
            <Color x:Key="AwayColor">#F59E0B</Color>
            <Color x:Key="OfflineColor">#475569</Color>
            <Color x:Key="ErrorColor">#EF4444</Color>
            <Color x:Key="WarningColor">#F59E0B</Color>

            <!-- Border Colors - Apple Dark Mode -->
            <Color x:Key="BorderColor">#38383A</Color>
            <Color x:Key="BorderLightColor">#48484A</Color>

            <!-- Glassmorphism 2.0 - Liquid Glass -->
            <Color x:Key="GlassBackgroundColor">#08FFFFFF</Color>
            <Color x:Key="GlassBorderColor">#15FFFFFF</Color>

            <!-- New: Modern Background Gradient -->
            <LinearGradientBrush x:Key="ModernBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F0F13" Offset="0"/>
                <GradientStop Color="#1A1A1F" Offset="0.5"/>
                <GradientStop Color="#121218" Offset="1"/>
            </LinearGradientBrush>

            <!-- Mesh Gradient Colors for Avatars - Apple Style -->
            <Color x:Key="Gradient1Start">#FF6482</Color>
            <Color x:Key="Gradient1End">#FF9F0A</Color>
            <Color x:Key="Gradient2Start">#30D158</Color>
            <Color x:Key="Gradient2End">#64D2FF</Color>
            <Color x:Key="Gradient3Start">#5E5CE6</Color>
            <Color x:Key="Gradient3End">#BF5AF2</Color>
            <Color x:Key="Gradient4Start">#FF375F</Color>
            <Color x:Key="Gradient4End">#FFD60A</Color>
            <Color x:Key="Gradient5Start">#64D2FF</Color>
            <Color x:Key="Gradient5End">#0A84FF</Color>
            <Color x:Key="Gradient6Start">#AC8E68</Color>
            <Color x:Key="Gradient6End">#8E8E93</Color>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- BRUSHES                                                             -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->

            <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource AccentDarkColor}"/>
            <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource AccentLightColor}"/>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>

            <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}"/>
            <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
            <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}"/>
            <SolidColorBrush x:Key="SidebarActiveBrush" Color="{StaticResource SidebarActiveColor}"/>

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

            <SolidColorBrush x:Key="BubbleSentBrush" Color="{StaticResource BubbleSentColor}"/>
            <SolidColorBrush x:Key="BubbleSentDarkBrush" Color="{StaticResource BubbleSentDarkColor}"/>
            <SolidColorBrush x:Key="BubbleReceivedBrush" Color="{StaticResource BubbleReceivedColor}"/>
            <SolidColorBrush x:Key="BubbleReceivedHoverBrush" Color="{StaticResource BubbleReceivedHoverColor}"/>

            <SolidColorBrush x:Key="OnlineBrush" Color="{StaticResource OnlineColor}"/>
            <SolidColorBrush x:Key="AwayBrush" Color="{StaticResource AwayColor}"/>
            <SolidColorBrush x:Key="OfflineBrush" Color="{StaticResource OfflineColor}"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
            <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>

            <SolidColorBrush x:Key="GlassBackgroundBrush" Color="{StaticResource GlassBackgroundColor}"/>
            <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource GlassBorderColor}"/>

            <!-- Sent Message Gradient - Apple Blue -->
            <LinearGradientBrush x:Key="SentBubbleGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A84FF" Offset="0"/>
                <GradientStop Color="#0066CC" Offset="1"/>
            </LinearGradientBrush>

            <!-- Mesh Gradient Brushes for Avatars -->
            <LinearGradientBrush x:Key="AvatarGradient1" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource Gradient1Start}" Offset="0"/>
                <GradientStop Color="{StaticResource Gradient1End}" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AvatarGradient2" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource Gradient2Start}" Offset="0"/>
                <GradientStop Color="{StaticResource Gradient2End}" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AvatarGradient3" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource Gradient3Start}" Offset="0"/>
                <GradientStop Color="{StaticResource Gradient3End}" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AvatarGradient4" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource Gradient4Start}" Offset="0"/>
                <GradientStop Color="{StaticResource Gradient4End}" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AvatarGradient5" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource Gradient5Start}" Offset="0"/>
                <GradientStop Color="{StaticResource Gradient5End}" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AvatarGradient6" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource Gradient6Start}" Offset="0"/>
                <GradientStop Color="{StaticResource Gradient6End}" Offset="1"/>
            </LinearGradientBrush>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- GLASSMORPHISM 2.0 EFFECTS                                           -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->

            <!-- Enhanced bubble shadow - 2026 design -->
            <DropShadowEffect x:Key="BubbleShadow" BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
            <DropShadowEffect x:Key="GlassShadow" BlurRadius="20" ShadowDepth="0" Opacity="0.4" Color="#000000"/>
            <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="#000000"/>

            <!-- Sky Blue Glow for peer names -->
            <DropShadowEffect x:Key="PeerNameGlow" BlurRadius="8" ShadowDepth="0" Opacity="0.4" Color="#0A84FF"/>

            <!-- Modern Accent Glow -->
            <DropShadowEffect x:Key="AccentGlow" BlurRadius="15" ShadowDepth="0" Opacity="0.5" Color="#0A84FF"/>
            <DropShadowEffect x:Key="AccentGlowSubtle" BlurRadius="8" ShadowDepth="0" Opacity="0.3" Color="#0A84FF"/>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- MESSAGE ANIMATION STORYBOARD                                        -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->

            <Storyboard x:Key="MessageFadeIn">
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                 From="20" To="0" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Key="TypingDotsAnimation">
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="0.4" To="1" Duration="0:0:0.5"
                                 AutoReverse="True" RepeatBehavior="Forever">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- BUTTON STYLES - 2026 Fresh Design                                   -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.3" Color="#0A84FF"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#3399FF"/>
                                    <Setter TargetName="border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.5" Color="#0A84FF"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#007AFF"/>
                                    <Setter TargetName="border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.2" Color="#0A84FF"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GlassButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    CornerRadius="19" Padding="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#1A0A84FF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#330A84FF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}"
                                    BorderBrush="Transparent" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#1AFFFFFF"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#29FFFFFF"/>
                                    <Setter TargetName="border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.3" Color="#0A84FF"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#33000000"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#4DFFFFFF"/>
                                    <Setter TargetName="border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.2" Color="#0A84FF"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Send Button with Glow Animation -->
            <Style x:Key="SendButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" CornerRadius="20" Width="40" Height="40">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0A84FF" Offset="0"/>
                                        <GradientStop Color="#5856D6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="glowEffect" BlurRadius="12" ShadowDepth="0" Opacity="0.4" Color="#0A84FF"/>
                                </Border.Effect>
                                <TextBlock Text="&#x2191;" FontSize="18" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontWeight="SemiBold" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform x:Name="arrowScale" ScaleX="1" ScaleY="1"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6" Color="#0A84FF"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.3" Color="#0A84FF"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- TEXTBOX STYLE - 2026 Fresh Design                                   -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->

            <Style x:Key="ModernTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="borderGlow" BlurRadius="0" ShadowDepth="0" Opacity="0" Color="#0A84FF"/>
                                </Border.Effect>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="borderGlow" Storyboard.TargetProperty="BlurRadius"
                                                                 To="8" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="borderGlow" Storyboard.TargetProperty="Opacity"
                                                                 To="0.3" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="borderGlow" Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Chat Input Style - Modern Pill Design -->
            <Style x:Key="ChatInputStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            </Style>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- SCROLLBAR STYLES                                                    -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->

            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="6"/>
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Height" Value="6"/>
                        <Setter Property="Width" Value="Auto"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- LISTBOX STYLES                                                      -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->

            <Style x:Key="ModernListBoxItem" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="bd" Background="Transparent" Padding="12,10">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource SidebarActiveBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>